# dependencies (bun install)
node_modules

.env
.env.development.local
.env.test.local
.env.production.local
.env.local

hugo/public
hugo/resources
hugo/.hugo_build.lock

# Staged DRG image PNGs, generated by scripts/generate-drg-images.ts.
# scripts/migrate-images-to-imagekit.ts uploads and deletes these locally —
# images are served from ImageKit, never committed (docs/adr/0012).
hugo/content/scouts-bsa/ranks/*/guide/images/*.png

# Local Hugo module workspace. To develop against a uni-theme checkout on
# disk, put the local path here rather than a `replace` directive in
# go.mod -- a committed replace names a path that only exists on one
# machine, and it broke the uni-theme bump workflow (see hugo/go.mod).
#   cd hugo && go work init . && go work use /path/to/uni-theme
#   HUGO_MODULE_WORKSPACE=go.work hugo server
hugo/go.work
hugo/go.work.sum

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Uses draft-07 for ajv-cli compatibility in local validation workflows.",
  "$id": "https://scouting.university/schemas/rank.schema.json",
  "title": "Rank",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "title",
    "slug",
    "short",
    "level",
    "program",
    "version_id",
    "version_effective_date",
    "header",
    "footer",
    "footnotes",
    "requirements"
  ],
  "properties": {
    "$schema": {
      "const": "../../../static/schemas/rank.schema.json"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "short": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "integer",
      "minimum": 1
    },
    "program": {
      "type": "string",
      "minLength": 1
    },
    "version_id": {
      "type": "string",
      "minLength": 1
    },
    "version_effective_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "header": {
      "type": "string"
    },
    "footer": {
      "type": "string"
    },
    "footnotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/footnote"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "$defs": {
    "footnote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker", "text"],
      "properties": {
        "marker": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "requirementList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {
          "enum": ["ul", "ol"]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "req_id",
        "path",
        "text",
        "list_number",
        "short",
        "months_since_last_rank_required",
        "eagle_mb_required",
        "total_mb_required",
        "service_hours_required"
      ],
      "properties": {
        "req_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "list_number": {
          "type": "string"
        },
        "short": {
          "type": "string"
        },
        "months_since_last_rank_required": {
          "type": "string"
        },
        "eagle_mb_required": {
          "type": "string"
        },
        "total_mb_required": {
          "type": "string"
        },
        "service_hours_required": {
          "type": "string"
        },
        "list": {
          "$ref": "#/$defs/requirementList"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      }
    }
  }
}
